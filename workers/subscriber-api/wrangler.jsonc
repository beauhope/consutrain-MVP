{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consutrain-subscriber-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",

  "workers_dev": false,
  "triggers": {
  "crons": [
    "*/15 * * * *"
  ]
},

  "routes": [
    {
      "pattern": "api.consutrain.com",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "consutrain-subscribers",
      "database_id": "5f22e9e2-00c1-418e-a157-f30876b8c94e",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    {
      "name": "SUBSCRIBE_IP_LIMITER",
      "namespace_id": "55001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIBE_EMAIL_LIMITER",
      "namespace_id": "55002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

 "secrets": {
  "required": [
    "UNSUBSCRIBE_SIGNING_SECRET",
    "RESEND_WEBHOOK_SECRET"
  ]
},
}
